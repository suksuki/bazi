{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dblife.com/schemas/v60/media-catalog-v1.schema.json",
  "title": "V60 Media Library Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "library_ref",
    "policy",
    "lifecycle",
    "character_identities",
    "items",
    "cue_bundles"
  ],
  "properties": {
    "schema_version": {
      "const": "v60.media-library.001"
    },
    "schema_ref": {
      "const": "media/schemas/media-catalog-v1.schema.json"
    },
    "library_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources_are_immutable",
        "new_revision_never_overwrites_old_revision",
        "runtime_registry_is_release_projection",
        "source_audio_is_never_embedded_in_actor_alpha_video",
        "owner_review_required_for_runtime_publication",
        "watermark_work_requires_owner_authorized_source"
      ],
      "properties": {
        "sources_are_immutable": {
          "const": true
        },
        "new_revision_never_overwrites_old_revision": {
          "const": true
        },
        "runtime_registry_is_release_projection": {
          "const": true
        },
        "source_audio_is_never_embedded_in_actor_alpha_video": {
          "const": true
        },
        "owner_review_required_for_runtime_publication": {
          "const": true
        },
        "watermark_work_requires_owner_authorized_source": {
          "const": true
        }
      }
    },
    "lifecycle": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "character_identities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/characterIdentity"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaItem"
      }
    },
    "cue_bundles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cueBundle"
      }
    }
  },
  "$defs": {
    "characterIdentity": {
      "type": "object",
      "required": [
        "character_version",
        "display_name",
        "visual_style",
        "status",
        "primary_for_new_v60_generation",
        "identity_reference_media_ref",
        "runtime_poster_media_ref",
        "motion_media_refs"
      ],
      "properties": {
        "character_version": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "visual_style": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "primary_for_new_v60_generation": {
          "type": "boolean"
        },
        "identity_reference_media_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_poster_media_ref": {
          "type": "string",
          "pattern": "^media\\."
        },
        "motion_media_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^media\\."
          }
        }
      }
    },
    "hashedArtifact": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source": {
      "allOf": [
        {
          "$ref": "#/$defs/hashedArtifact"
        },
        {
          "type": "object",
          "required": [
            "original_filename",
            "generator",
            "prompt_status",
            "authorization"
          ],
          "properties": {
            "original_filename": {
              "type": "string",
              "minLength": 1
            },
            "generator": {
              "type": "string",
              "minLength": 1
            },
            "prompt_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "prompt_status": {
              "type": "string",
              "minLength": 1
            },
            "authorization": {
              "type": "string",
              "pattern": "^OWNER_APPROVED"
            }
          }
        }
      ]
    },
    "delivery": {
      "allOf": [
        {
          "$ref": "#/$defs/hashedArtifact"
        },
        {
          "type": "object",
          "required": [
            "asset_ref",
            "asset_version",
            "role",
            "alpha"
          ],
          "properties": {
            "asset_ref": {
              "type": "string",
              "minLength": 1
            },
            "asset_version": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "alpha": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "mediaItem": {
      "type": "object",
      "required": [
        "media_ref",
        "asset_id",
        "revision",
        "media_kind",
        "semantic_role",
        "library_status",
        "source",
        "process_manifest_path",
        "process_manifest_sha256",
        "deliveries",
        "runtime_contract"
      ],
      "properties": {
        "media_ref": {
          "type": "string",
          "pattern": "^media\\."
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
        },
        "revision": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "media_kind": {
          "type": "string",
          "minLength": 1
        },
        "semantic_role": {
          "type": "string",
          "minLength": 1
        },
        "library_status": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "process_manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "process_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "masters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hashedArtifact"
          }
        },
        "deliveries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivery"
          }
        },
        "review_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hashedArtifact"
          }
        },
        "runtime_contract": {
          "type": "object"
        }
      }
    },
    "cueBundle": {
      "type": "object",
      "required": [
        "cue_ref",
        "version",
        "status",
        "trigger",
        "visual_media_ref",
        "audio_media_refs",
        "sync",
        "reduced_motion"
      ],
      "properties": {
        "cue_ref": {
          "type": "string",
          "pattern": "^cue\\."
        },
        "version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "visual_media_ref": {
          "type": "string",
          "pattern": "^media\\."
        },
        "audio_media_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^media\\."
          }
        },
        "sync": {
          "type": "object"
        },
        "reduced_motion": {
          "type": "object"
        }
      }
    }
  }
}
