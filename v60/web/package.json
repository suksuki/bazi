{
  "name": "abu-knows-v60-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "preview": "vite preview --host 127.0.0.1",
    "audit:visual": "node tools/visual-audit.mjs",
    "audit:first-slice": "node tools/first-slice-audit.mjs",
    "audit:return-slice": "node tools/return-slice-audit.mjs",
    "audit:product-slice": "node tools/product-slice-audit.mjs",
    "audit:guide-left": "node tools/guide-left-audit.mjs",
    "audit:semantic-focus": "node tools/semantic-focus-audit.mjs",
    "audit:explanation-slice": "node tools/explanation-slice-audit.mjs",
    "audit:mechanism-qualification": "node tools/mechanism-qualification-audit.mjs",
    "audit:mechanism-evidence-depth": "node tools/mechanism-evidence-depth-audit.mjs",
    "audit:source-coordinate-review": "node tools/source-coordinate-review-audit.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
