# 服务器上：复制为 .env.production 后执行 pnpm build
# 前提：Nginx 已把 https://你的域名/api/ 反代到本机 uvicorn（见 ../deploy/nginx-qiazhi-dblife.example.conf）

# 必须：Nginx 已处理 /api 时，禁止 Next 再 rewrite /api（否则会抢或双反代）
NEXT_PUBLIC_QIAZHI_DISABLE_SAME_ORIGIN_REWRITE=1

# 必须：不要写 http://127.0.0.1:8001。留空 = 浏览器打同源 /api/...
NEXT_PUBLIC_QIAZHI_API=

# 与后端 backend/.env 中 QIAZHI_ADMIN_TOKEN 一致（勿提交真实密钥到 git）
NEXT_PUBLIC_QIAZHI_ADMIN_TOKEN=local-dev-qiazhi-admin
