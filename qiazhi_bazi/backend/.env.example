# 复制为 .env 后按需修改。未设置非空 QIAZHI_ADMIN_TOKEN 时，/api/admin/* 会返回 503。
QIAZHI_ADMIN_TOKEN=local-dev-qiazhi-admin

# 可选追加源（会与内置默认合并，含 https://dblife.com）。仅当 QIAZHI_CORS_ORIGINS 未写全时再用。
# QIAZHI_CORS_EXTRA_ORIGINS=https://staging.example.com

# Ollama 低延迟（可选）：FAST_LITE 默认收紧 num_ctx；OPTIONS_JSON 并入所有 /api/chat 的 options。
# QIAZHI_OLLAMA_FAST_LITE=1
# QIAZHI_OLLAMA_OPTIONS_JSON={"num_ctx":2048,"num_batch":128}
# 仅推理链模型需要时：QIAZHI_OLLAMA_CHAT_THINK_FALSE=1

# LLM 接入（与 QIAZHI_BAZI_LLM_* 一致时可二选一；终判/审计读 runtime_config 合并结果）
# QIAZHI_BAZI_LLM_BASE_URL=http://127.0.0.1:11434/v1
# QIAZHI_BAZI_LLM_MODEL=qwen2.5

# 强模型日切：1/true/yes 时 is_high_reasoning_mode=true（终判全量 evidence + 高推理契约）。
# 若 runtime_config.json 的 llm 中显式写了 is_high_reasoning_mode，则该文件值覆盖本环境变量。
QIAZHI_LLM_HIGH_REASONING=0
