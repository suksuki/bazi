# V20 runtime profile.
# Copy to an untracked local env file before use; do not commit real secrets.

V20_ENV=local_macos
V20_HOST=127.0.0.1
V20_PUBLIC_HOST=127.0.0.1
V20_PORT=9020
V20_RUNTIME_DIR=v20/.runtime/local
V20_SERVICE_NAME=qiazhi-v20-local

# Linux server profile reference. Use this on the 0.13 server or in deploy tooling.
V20_REMOTE_PROFILE=linux_0_13
V20_REMOTE_HOST=0.13

# Postgres is the persistent authority for reviewed knowledge, ledgers, registries,
# corpus snapshots, and feedback records.
V20_POSTGRES_ENABLED=1
V20_POSTGRES_HOST=127.0.0.1
V20_POSTGRES_PORT=5432
V20_POSTGRES_DB=qiazhi_v20_local
V20_POSTGRES_USER=qiazhi_v20_app
V20_POSTGRES_PASSWORD=CHANGE_ME
V20_DATABASE_URL=postgresql://qiazhi_v20_app:CHANGE_ME@127.0.0.1:5432/qiazhi_v20_local?sslmode=prefer

# Redis is ephemeral: cache, queue, rate-limit, distributed lock, short TTL state.
# Do not treat Redis as an authoritative data source and do not sync it across hosts.
V20_REDIS_ENABLED=1
V20_REDIS_HOST=127.0.0.1
V20_REDIS_PORT=6379
V20_REDIS_DB=20
V20_REDIS_URL=redis://127.0.0.1:6379/20
