{
  "version": "deepbazi.runtime_authority.v1",
  "production_entrypoints": [
    "apps/product/app.py",
    "apps/product/agent_api.py"
  ],
  "production_authoritative": {
    "fact_and_calendar": ["core.contracts", "core.engines"],
    "cognitive_system": ["core.mingli_agent"],
    "interaction_and_memory": ["core.abu_runtime", "product"]
  },
  "experimental_advisory_tools": {
    "graph_v1": {
      "modules": ["core.graph"],
      "authority": "experimental_tool_observation"
    },
    "path_v1": {
      "modules": ["core.graph", "core.simulation"],
      "authority": "experimental_candidate_generator"
    },
    "role_v1": {
      "modules": ["core.graph"],
      "authority": "experimental_role_annotation"
    },
    "ablation_v1": {
      "modules": ["core.simulation"],
      "authority": "estimated_sensitivity"
    }
  },
  "research_only": [
    "core.mechanism",
    "core.state",
    "core.timing"
  ],
  "research_projection_authority": {
    "mechanism": "research_projection",
    "unified_state": "research_projection",
    "theme": "research_projection",
    "decision_confidence": "uncalibrated_research_indicator"
  },
  "retired_capabilities": [
    "alpha_session_runtime",
    "deterministic_brain_reading",
    "template_product_projection"
  ],
  "rules": {
    "llm_is_cognitive_reasoner": true,
    "facts_are_tool_authoritative": true,
    "experimental_tools_may_not_enter_independent_first_look": true,
    "experimental_tools_may_not_be_presented_as_fact": true,
    "research_modules_may_not_create_production_judgment": true,
    "synthetic_expected_contract_may_not_enter_reasoning_context": true,
    "product_projection_may_not_invent_claims": true
  }
}
