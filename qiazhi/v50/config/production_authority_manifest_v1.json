{
  "version": "deepbazi.production_authority_manifest.v2",
  "registry_status": "canonical_module_and_schema_owner",
  "supersedes": [
    "data_authority_v1.json",
    "runtime_authority_v1.json",
    "frontend_state_authority_v1.json",
    "canonical_scene_authority_v1.json"
  ],
  "allowed_statuses": [
    "production",
    "experimental",
    "research",
    "deprecated",
    "archived"
  ],
  "runtime_boundaries": {
    "production_entrypoints": ["apps/product/app.py", "apps/product/agent_api.py"],
    "production_authoritative": {
      "fact_and_calendar": ["core.contracts", "core.engines"],
      "cognitive_system": ["core.mingli_agent"],
      "formal_case": ["core.life_case"],
      "canonical_scene": ["experience.canonical_scene", "product.canonical_scene"],
      "interaction_and_memory": ["core.abu_runtime", "product"]
    },
    "experimental_advisory_tools": {
      "graph_v1": {
        "modules": ["core.graph"],
        "authority": "experimental_tool_observation"
      },
      "path_v1": {
        "modules": ["core.graph", "core.simulation"],
        "authority": "experimental_candidate_generator"
      },
      "role_v1": {
        "modules": ["core.graph"],
        "authority": "experimental_role_annotation"
      },
      "ablation_v1": {
        "modules": ["core.simulation"],
        "authority": "estimated_sensitivity"
      }
    },
    "research_only": ["core.mechanism", "core.state", "core.timing"],
    "research_projection_authority": {
      "mechanism": "research_projection",
      "unified_state": "research_projection",
      "theme": "research_projection",
      "decision_confidence": "uncalibrated_research_indicator"
    },
    "retired_capabilities": [
      "alpha_session_runtime",
      "deterministic_brain_reading",
      "template_product_projection"
    ]
  },
  "formal_data_authority": {
    "chart_facts": "ChartWorldInstance + LifeCase.chart_version",
    "whole_chart_cognition": "LifeCase.baseline_insight",
    "domain_cognition": "LifeCase.domain_insights",
    "reality_feedback": "LifeCase.reality_evidence",
    "temporal_state": "LifeCase.temporal_snapshots",
    "relation_path_assertions": "LifeCase relation/path assertion history",
    "canonical_scene": "CanonicalSceneOwner",
    "workspace_ui_state": "experience.workspace.CaseWorkspaceState (non-cognitive)"
  },
  "module_ownership": {
    "baseline_command": "product.agent_command_service.BaselineCaseCommandService",
    "database_schema": "deploy/postgres_v50_schema.sql",
    "database_schema_checker": "product.database_schema.check_product_database_schema",
    "database_schema_migration": "product.database_schema.migrate_product_database_schema",
    "experience_contracts": "Python Pydantic models under packages/experience",
    "typescript_contract_projection": "scripts/v50_export_experience_schemas.py",
    "canonical_scene": "product.canonical_scene.CanonicalSceneOwner",
    "formal_relation_path": "core.life_case.LifeCase",
    "candidate_relation_path": "core.graph + core.simulation",
    "case_belief_state": "core.mingli_agent.workspace.CaseBeliefState",
    "workspace_ui_state": "experience.workspace.CaseWorkspaceState",
    "mingli_lab_session": "experience.lab.MingliLabSession",
    "abu_narration": "product.abu_narration.AbuNarrationService",
    "offline_fixture_generation": "tools.fixtures (non-runtime)"
  },
  "schema_ownership": {
    "authoritative_source": "Python Pydantic models",
    "json_schema_projection": "docs/product/contracts/abu-living-theater-v1/*.schema.json",
    "typescript_projection": "apps/product/experience_shell/src/contracts.generated.ts",
    "typescript_handwritten_contract_owner": false,
    "api_validation": "FastAPI response_model or service-boundary validation uses the same Pydantic models",
    "drift_command": "PYTHONPATH=packages:apps python scripts/v50_export_experience_schemas.py"
  },
  "projection_rules": {
    "projection_owns_facts": false,
    "client_may_submit_formal_chart_facts": false,
    "client_may_submit_formal_relation_or_path": false,
    "role_hidden_content_may_reappear_by_fallback": false,
    "frontend_formal_state_restore": false
  },
  "classification": {
    "canonical": [
      "LifeCase formal cognition",
      "CanonicalSceneOwner",
      "CaseBeliefState",
      "CaseWorkspaceState",
      "MingliLabSession",
      "AbuNarrationService",
      "BaselineCaseCommandService",
      "postgres_v50_schema.sql",
      "Python Pydantic experience contracts",
      "production_authority_manifest_v1.json"
    ],
    "transitional": [
      "Graph/Path v1 candidate adapter",
      "Theater chart_facts_only compatibility projection",
      "legacy route usage measurement"
    ],
    "legacy": [
      "static/l5 retiring shell",
      "archived report-shaped formal state",
      "superseded split authority registries"
    ],
    "new_transitional_layers_allowed": false
  },
  "authorities": {
    "calendar_and_chart_facts": {
      "status": "production",
      "modules": ["core.contracts", "core.engines"],
      "authority_role": "deterministic_fact_authority",
      "evidence_status": "OPERATIONAL"
    },
    "ziwei_fact_bridge": {
      "status": "production",
      "modules": ["core.ziwei"],
      "authority_role": "supporting_fact_authority",
      "evidence_status": "PROVISIONAL"
    },
    "mingli_llm_reasoner": {
      "status": "production",
      "modules": ["core.mingli_agent.reasoner", "core.mingli_agent.orchestrator"],
      "authority_role": "cognitive_reasoner_candidate",
      "evidence_status": "UNVALIDATED"
    },
    "epistemic_review": {
      "status": "production",
      "modules": ["core.mingli_agent.fact_review", "core.mingli_agent.quality"],
      "authority_role": "annotation_and_projection_gate",
      "evidence_status": "BLOCKED"
    },
    "graph_v1": {
      "status": "experimental",
      "modules": ["core.graph"],
      "authority_role": "challenge_observation_only",
      "evidence_status": "PROVISIONAL"
    },
    "path_v1": {
      "status": "experimental",
      "modules": ["core.graph", "core.simulation"],
      "authority_role": "challenge_candidate_generator",
      "evidence_status": "PROVISIONAL"
    },
    "role_v1": {
      "status": "experimental",
      "modules": ["core.graph"],
      "authority_role": "challenge_annotation_only",
      "evidence_status": "PROVISIONAL"
    },
    "ablation_v1": {
      "status": "experimental",
      "modules": ["core.simulation"],
      "authority_role": "estimated_sensitivity_not_counterfactual_truth",
      "evidence_status": "PROVISIONAL"
    },
    "mechanism_ast": {
      "status": "research",
      "modules": ["core.mechanism"],
      "authority_role": "research_projection",
      "evidence_status": "RESEARCH_ONLY"
    },
    "unified_state": {
      "status": "research",
      "modules": ["core.state"],
      "authority_role": "research_projection",
      "evidence_status": "RESEARCH_ONLY"
    },
    "theme": {
      "status": "research",
      "modules": ["core.state.theme_discovery"],
      "authority_role": "research_projection",
      "evidence_status": "RESEARCH_ONLY"
    },
    "legacy_confidence": {
      "status": "research",
      "modules": ["core.state.decision_confidence"],
      "authority_role": "uncalibrated_research_indicator",
      "evidence_status": "RESEARCH_ONLY"
    },
    "life_case": {
      "status": "production",
      "modules": ["core.life_case"],
      "authority_role": "formal_case_cognition_authority",
      "evidence_status": "PROVISIONAL"
    },
    "relation_path_assertions": {
      "status": "production",
      "modules": ["core.graph.provenance", "core.life_case.relation_path"],
      "authority_role": "stable_identity_and_append_only_assertion_contract_owned_by_life_case",
      "evidence_status": "OPERATIONAL"
    },
    "canonical_scene": {
      "status": "production",
      "modules": ["experience.canonical_scene", "product.canonical_scene"],
      "authority_role": "single_case_scene_projection_owner",
      "evidence_status": "OPERATIONAL"
    },
    "role_projection": {
      "status": "production",
      "modules": ["apps.product.reading_projection"],
      "authority_role": "visibility_and_density_only",
      "evidence_status": "OPERATIONAL"
    },
    "abu_runtime": {
      "status": "production",
      "modules": ["core.abu_runtime"],
      "authority_role": "navigation_not_mingli_judgment",
      "evidence_status": "OPERATIONAL"
    },
    "deterministic_brain_reading": {
      "status": "deprecated",
      "modules": [],
      "authority_role": "none",
      "evidence_status": "ARCHIVED"
    },
    "template_product_projection": {
      "status": "archived",
      "modules": [],
      "authority_role": "none",
      "evidence_status": "ARCHIVED"
    }
  },
  "rules": {
    "independent_first_look_allowed_statuses": ["production"],
    "challenge_pack_allowed_statuses": ["production", "experimental"],
    "guest_member_forbidden_statuses": ["experimental", "research", "deprecated", "archived"],
    "raw_cognition_may_be_rewritten_by_review": false,
    "review_may_annotate": true,
    "review_may_suppress_high_risk_projection": true
  },
  "guest_member_forbidden_fields": [
    "mechanism_ast",
    "unified_state",
    "theme_bundle",
    "decision_confidence_profile",
    "theory_refs",
    "context_manifest",
    "stage_receipts"
  ]
}
