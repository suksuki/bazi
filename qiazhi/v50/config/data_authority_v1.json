{
  "schema_version": "deepbazi.data_authority.v1",
  "frozen_at": "2026-07-20",
  "principle": "Each formal concept has one authority; compatibility views are derived and never written back.",
  "authorities": [
    {
      "concept": "chart_facts",
      "authority": "ChartWorldInstance + LifeCase.chart_version",
      "write_owner": "deterministic chart compilation",
      "experience_projection": "CanonicalScene.chart_facts -> CanonicalProjectionEnvelope"
    },
    {
      "concept": "whole_chart_cognition",
      "authority": "LifeCase.baseline_insight",
      "write_owner": "commit_baseline_life_case after Reliability Gate",
      "experience_projection": "CanonicalScene.approved_claims -> CanonicalProjectionEnvelope"
    },
    {
      "concept": "domain_cognition",
      "authority": "LifeCase.domain_insights",
      "write_owner": "commit_domain_insight after Reliability Gate",
      "experience_projection": "CanonicalScene.approved_claims scoped by role and projection"
    },
    {
      "concept": "reality_feedback",
      "authority": "LifeCase.reality_evidence",
      "write_owner": "RealityEvidence application service",
      "experience_projection": "not disclosed by baseline envelope"
    },
    {
      "concept": "temporal_state",
      "authority": "LifeCase.temporal_snapshots",
      "write_owner": "TemporalSnapshot application service",
      "experience_projection": "CanonicalScene.temporal_state -> CanonicalProjectionEnvelope"
    },
    {
      "concept": "workspace_ui_state",
      "authority": "WorkspaceState",
      "write_owner": "workspace application service",
      "experience_projection": "client UI state only; never formal cognition"
    },
    {
      "concept": "canonical_scene",
      "authority": "CanonicalSceneCompiler",
      "write_owner": "CanonicalSceneOwner reads ChartWorldInstance and committed LifeCase only",
      "experience_projection": "OneCanvas, Abu, Theater, Xiangfa and Workspace adapters"
    }
  ],
  "forbidden_formal_authorities": [
    "legacy Report",
    "legacy page Store",
    "RunRecord restoration",
    "conversation transcript",
    "frontend state",
    "legacy record restoration",
    "projection-specific scene assembly"
  ]
}
