{
  "$defs": {
    "CanvasSandboxMutation": {
      "additionalProperties": false,
      "properties": {
        "mutation_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Mutation Id",
          "type": "string"
        },
        "action_type": {
          "enum": [
            "set_luck",
            "set_year",
            "replace_year",
            "clear_year"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "field_path": {
          "enum": [
            "temporal.luck",
            "temporal.year"
          ],
          "title": "Field Path",
          "type": "string"
        },
        "before_layer_id": {
          "default": "",
          "maxLength": 180,
          "title": "Before Layer Id",
          "type": "string"
        },
        "after_layer_id": {
          "default": "",
          "maxLength": 180,
          "title": "After Layer Id",
          "type": "string"
        },
        "base_snapshot_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Base Snapshot Id",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "derived",
            "hypothetical"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "mutation_id",
        "action_type",
        "field_path",
        "base_snapshot_id",
        "source_mode",
        "source_refs"
      ],
      "title": "CanvasSandboxMutation",
      "type": "object"
    },
    "MingliLabSession": {
      "additionalProperties": false,
      "description": "Shared non-authoritative identity for every Mingli Lab experiment.",
      "properties": {
        "schema_version": {
          "const": "deepbazi.mingli_lab_session.v1",
          "default": "deepbazi.mingli_lab_session.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "participant_run_id": {
          "default": "",
          "maxLength": 180,
          "title": "Participant Run Id",
          "type": "string"
        },
        "case_ref": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Case Ref",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "scene_source_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Scene Source Hash",
          "type": "string"
        },
        "disclosure_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Disclosure Hash",
          "type": "string"
        },
        "experiment_kind": {
          "enum": [
            "mechanism_ablation",
            "temporal_hypothesis",
            "relation_inspection",
            "candidate_interpretation",
            "competing_path_comparison",
            "synthetic_case",
            "counterexample_review",
            "algorithm_change_validation"
          ],
          "title": "Experiment Kind",
          "type": "string"
        },
        "base_snapshot_ref": {
          "maxLength": 220,
          "minLength": 1,
          "title": "Base Snapshot Ref",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "canonical_projection",
            "synthetic_fixture",
            "legacy_unresolved"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "synthetic_fixture_ref": {
          "default": "",
          "maxLength": 220,
          "title": "Synthetic Fixture Ref",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "modified",
            "restored",
            "saved",
            "discarded"
          ],
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "writes_chart": {
          "const": false,
          "default": false,
          "title": "Writes Chart",
          "type": "boolean"
        },
        "writes_life_case": {
          "const": false,
          "default": false,
          "title": "Writes Life Case",
          "type": "boolean"
        },
        "promotes_candidate": {
          "const": false,
          "default": false,
          "title": "Promotes Candidate",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "case_ref",
        "scene_id",
        "scene_source_hash",
        "disclosure_hash",
        "experiment_kind",
        "base_snapshot_ref",
        "source_mode",
        "created_at",
        "updated_at"
      ],
      "title": "MingliLabSession",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "deepbazi.temporal_sandbox_state.v2",
      "enum": [
        "deepbazi.temporal_sandbox_state.v1",
        "deepbazi.temporal_sandbox_state.v2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "lab_session": {
      "$ref": "#/$defs/MingliLabSession"
    },
    "base_luck_layer_id": {
      "default": "",
      "maxLength": 180,
      "title": "Base Luck Layer Id",
      "type": "string"
    },
    "base_year_layer_id": {
      "default": "",
      "maxLength": 180,
      "title": "Base Year Layer Id",
      "type": "string"
    },
    "selected_luck_layer_id": {
      "default": "",
      "maxLength": 180,
      "title": "Selected Luck Layer Id",
      "type": "string"
    },
    "selected_year_layer_id": {
      "default": "",
      "maxLength": 180,
      "title": "Selected Year Layer Id",
      "type": "string"
    },
    "mutations": {
      "items": {
        "$ref": "#/$defs/CanvasSandboxMutation"
      },
      "title": "Mutations",
      "type": "array"
    },
    "current_canvas_spec_id": {
      "default": "",
      "maxLength": 180,
      "title": "Current Canvas Spec Id",
      "type": "string"
    },
    "current_diff_spec_id": {
      "default": "",
      "maxLength": 180,
      "title": "Current Diff Spec Id",
      "type": "string"
    }
  },
  "required": [
    "lab_session"
  ],
  "title": "TemporalSandboxState",
  "type": "object"
}
