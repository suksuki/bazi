        "participant_node_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "title": "Participant Node Refs",
          "type": "array"
        },
        "relation_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Relation Type",
          "type": "string"
        },
        "label": {
          "maxLength": 140,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "semantic_state": {
          "default": "active",
          "enum": [
            "latent",
            "active",
            "reinforced",
            "weakened",
            "blocked"
