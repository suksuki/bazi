        "epistemic_status": {
          "enum": [
            "fact",
            "derived",
            "candidate",
            "committed",
            "blocked",
            "hypothetical",
            "presentation_only"
          ],
          "title": "Epistemic Status",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "commitment_refs": {
          "items": {
            "type": "string"
          },
          "title": "Commitment Refs",
          "type": "array"
        },
        "uncertainty": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainty",
          "type": "array"
        },
        "rejection_or_block_reasons": {
          "items": {
            "type": "string"
