{
  "$defs": {
    "CanvasCluster": {
      "additionalProperties": false,
      "properties": {
        "cluster_ref": {
          "maxLength": 220,
          "minLength": 1,
          "title": "Cluster Ref",
          "type": "string"
        },
        "label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "node_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Node Refs",
          "type": "array"
        },
        "relation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Relation Refs",
          "type": "array"
        },
        "trace": {
          "$ref": "#/$defs/CanvasTrace"
        }
      },
      "required": [
        "cluster_ref",
        "label",
        "node_refs",
        "trace"
      ],
      "title": "CanvasCluster",
      "type": "object"
    },
    "CanvasEpistemology": {
      "additionalProperties": false,
      "properties": {
        "epistemic_statuses": {
          "items": {
            "enum": [
              "fact",
              "derived",
              "candidate",
              "committed",
              "blocked",
              "hypothetical",
              "presentation_only"
            ],
            "type": "string"
          },
          "title": "Epistemic Statuses",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "commitment_refs": {
          "items": {
            "type": "string"
          },
          "title": "Commitment Refs",
          "type": "array"
        },
        "uncertainty": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainty",
          "type": "array"
        },
        "rejection_or_block_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Rejection Or Block Reasons",
          "type": "array"
        },
        "must_not_say": {
          "items": {
            "type": "string"
          },
          "title": "Must Not Say",
          "type": "array"
        }
      },
      "required": [
        "epistemic_statuses",
        "source_refs",
        "commitment_refs",
        "uncertainty",
        "rejection_or_block_reasons",
        "must_not_say"
      ],
      "title": "CanvasEpistemology",
      "type": "object"
    },
    "CanvasIdentity": {
      "additionalProperties": false,
      "properties": {
        "canvas_spec_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Canvas Spec Id",
          "type": "string"
        },
        "chart_version_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Chart Version Id",
          "type": "string"
        },
        "temporal_snapshot_id": {
          "default": "",
          "maxLength": 180,
          "title": "Temporal Snapshot Id",
          "type": "string"
        },
        "life_case_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Life Case Id",
          "type": "string"
        },
        "sandbox_session_id": {
          "default": "",
          "maxLength": 180,
          "title": "Sandbox Session Id",
          "type": "string"
        },
        "compiler_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Compiler Version",
          "type": "string"
        },
        "compiled_at": {
          "format": "date-time",
          "title": "Compiled At",
          "type": "string"
        },
        "audience_role": {
          "anyOf": [
            {
              "enum": [
                "guest",
                "member",
                "practitioner",
                "research",
                "admin"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience Role"
        },
        "content_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "canvas_spec_id",
        "chart_version_id",
        "life_case_id",
        "compiler_version",
        "compiled_at",
        "content_hash"
      ],
