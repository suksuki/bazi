[Unit]
Description=V17 Rebirth Backend (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=hlsystem
Group=hlsystem
WorkingDirectory=/home/hlsystem/bazi/qiazhi
Environment=PYTHONPATH=/home/hlsystem/bazi/qiazhi
ExecStart=/home/hlsystem/.local/bin/uvicorn v17_rebirth.backend.api.app:app --host 0.0.0.0 --port 8017
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=append:/home/hlsystem/bazi/qiazhi/v17_rebirth/.runlogs/backend-8017.log
StandardError=append:/home/hlsystem/bazi/qiazhi/v17_rebirth/.runlogs/backend-8017.log

[Install]
WantedBy=multi-user.target
