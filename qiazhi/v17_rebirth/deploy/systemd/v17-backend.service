[Unit]
Description=V17 Rebirth Backend (FastAPI/Uvicorn)
After=network.target

[Service]
Type=simple
User=hlsystem
Group=hlsystem
WorkingDirectory=/home/hlsystem/bazi/qiazhi
Environment=PYTHONPATH=/home/hlsystem/bazi/qiazhi
Environment=PYTHONUNBUFFERED=1
# V17.16：Uvicorn 无 Gunicorn 式 --no-buffer；以 stdbuf 行缓冲 stdout/stderr 逼近「无缓冲」刷新（需 coreutils 的 /usr/bin/stdbuf）。
ExecStart=/usr/bin/stdbuf -oL -eL /home/hlsystem/.local/bin/uvicorn v17_rebirth.backend.api.app:app --host 0.0.0.0 --port 8017 --proxy-headers --timeout-keep-alive 75
Restart=always
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=append:/home/hlsystem/bazi/qiazhi/v17_rebirth/.runlogs/backend-8017.log
StandardError=append:/home/hlsystem/bazi/qiazhi/v17_rebirth/.runlogs/backend-8017.log

[Install]
WantedBy=multi-user.target
