[Unit]
Description=V17 Frontend (Next.js production on 3001)
After=network.target

[Service]
Type=simple
User=hlsystem
Group=hlsystem
WorkingDirectory=/home/hlsystem/bazi/qiazhi/v17_rebirth/frontend
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_QIAZHI_API=https://dblife.com/api
ExecStart=/usr/bin/env bash -lc 'pnpm start -p 3001'
Restart=always
RestartSec=2
TimeoutStopSec=30
StandardOutput=append:/home/hlsystem/bazi/qiazhi/v17_rebirth/.runlogs/frontend-3001.log
StandardError=append:/home/hlsystem/bazi/qiazhi/v17_rebirth/.runlogs/frontend-3001.log

[Install]
WantedBy=multi-user.target
