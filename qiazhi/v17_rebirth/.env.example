# V17 Rebirth — 环境变量配置示例
# 复制为 .env 并按实际环境填充

# ─── V17 API 安全 ─────────────────────────────────────────────────────────────
# 生产环境推荐设置为高强度随机字符串（openssl rand -hex 32）
# 未设置时退化为 "v17_rebirth"（开发兼容）
QIAZHI_V17_API_SECRET=v17_rebirth

# ─── Redis 状态后端 ───────────────────────────────────────────────────────────
# 未设置 → 使用进程内 MemoryStateBackend（单 worker 兼容）
# 生产多 worker → 必须配置此项，否则跨 worker Action 信号丢失
# 格式: redis://[username:password@]host:port/db
QIAZHI_REDIS_URL=redis://127.0.0.1:6379/0

# ─── LLM 配置 ────────────────────────────────────────────────────────────────
QIAZHI_LLM_PROVIDER=ollama
QIAZHI_LLM_BASE_URL=http://127.0.0.1:11434/v1
QIAZHI_LLM_MODEL=qwen2.5:7b
QIAZHI_LLM_API_KEY=

# ─── V17 流式参数 ─────────────────────────────────────────────────────────────
# SSE heartbeat 间隔（秒），默认 2.0
QIAZHI_V17_SSE_HEARTBEAT_SEC=2.0
# LLM hard 熔断（秒），默认 10.0
QIAZHI_V17_FUSE_HARD_SEC=10.0
# TTFT 超时（秒），默认 20.0
QIAZHI_V17_LLM_TTFT_SEC=20.0
# 并发 LLM 上限，默认 3
QIAZHI_V17_FUSE_MAX_PARALLEL=3
# 禁用 reasoning/thinking 模式（1=禁用），默认 1
QIAZHI_V17_DISABLE_REASONING=1

# ─── 数据库（可选）───────────────────────────────────────────────────────────
# QIAZHI_DATABASE_URL=postgresql://user:password@localhost:5432/qiazhi_v17
