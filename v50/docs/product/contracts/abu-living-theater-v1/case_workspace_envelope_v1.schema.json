{
  "$defs": {
    "CanonicalProjectionEnvelope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "deepbazi.canonical_projection_envelope.v1",
          "default": "deepbazi.canonical_projection_envelope.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "projection_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Projection Id",
          "type": "string"
        },
        "projection_kind": {
          "enum": [
            "onecanvas",
            "abu",
            "theater",
            "xiangfa",
            "workspace"
          ],
          "title": "Projection Kind",
          "type": "string"
        },
        "scene_identity": {
          "$ref": "#/$defs/CanonicalSceneIdentity"
        },
        "role_disclosure": {
          "$ref": "#/$defs/CanonicalRoleDisclosure"
        },
        "adapter_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Adapter Id",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "semantic_refs": {
          "items": {
            "type": "string"
          },
          "title": "Semantic Refs",
          "type": "array"
        },
        "projection_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Projection Hash",
          "type": "string"
        },
        "creates_mingli_facts": {
          "const": false,
          "default": false,
          "title": "Creates Mingli Facts",
          "type": "boolean"
        },
        "creates_mingli_claims": {
          "const": false,
          "default": false,
          "title": "Creates Mingli Claims",
          "type": "boolean"
        },
        "writes_chart": {
          "const": false,
          "default": false,
          "title": "Writes Chart",
          "type": "boolean"
        },
        "writes_life_case": {
          "const": false,
          "default": false,
          "title": "Writes Life Case",
          "type": "boolean"
        }
      },
      "required": [
        "projection_id",
        "projection_kind",
        "scene_identity",
        "role_disclosure",
        "adapter_id",
        "payload",
        "semantic_refs",
        "projection_hash"
      ],
      "title": "CanonicalProjectionEnvelope",
      "type": "object"
    },
    "CanonicalRoleDisclosure": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "const": "canonical-scene-disclosure.v1",
          "default": "canonical-scene-disclosure.v1",
          "title": "Policy Version",
          "type": "string"
        },
        "role": {
          "enum": [
            "guest",
            "member",
            "practitioner",
            "research",
            "admin"
          ],
          "title": "Role",
          "type": "string"
        },
        "disclosure_level": {
          "enum": [
            "chart_facts",
            "approved_insights",
            "professional",
            "research"
          ],
          "title": "Disclosure Level",
          "type": "string"
        },
        "visible_fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Visible Fact Refs",
          "type": "array"
        },
        "visible_claim_refs": {
          "items": {
            "type": "string"
          },
          "title": "Visible Claim Refs",
          "type": "array"
        },
        "visible_reasoning_step_refs": {
          "items": {
            "type": "string"
          },
          "title": "Visible Reasoning Step Refs",
          "type": "array"
        },
        "visible_hypothesis_refs": {
          "items": {
            "type": "string"
          },
          "title": "Visible Hypothesis Refs",
          "type": "array"
        },
        "visible_temporal_refs": {
          "items": {
            "type": "string"
          },
          "title": "Visible Temporal Refs",
          "type": "array"
        },
        "visible_relation_assertion_refs": {
          "items": {
            "type": "string"
          },
          "title": "Visible Relation Assertion Refs",
          "type": "array"
        },
        "visible_path_assertion_refs": {
          "items": {
            "type": "string"
          },
          "title": "Visible Path Assertion Refs",
          "type": "array"
        },
        "prohibited_fields": {
          "items": {
            "type": "string"
          },
          "title": "Prohibited Fields",
          "type": "array"
        },
        "prohibited_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Prohibited Capabilities",
          "type": "array"
        },
        "disclosure_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Disclosure Hash",
          "type": "string"
        }
      },
      "required": [
        "role",
        "disclosure_level",
        "visible_fact_refs",
        "visible_claim_refs",
        "visible_reasoning_step_refs",
        "visible_hypothesis_refs",
        "visible_temporal_refs",
        "prohibited_fields",
        "prohibited_capabilities",
        "disclosure_hash"
      ],
      "title": "CanonicalRoleDisclosure",
      "type": "object"
    },
    "CanonicalSceneIdentity": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "compiler_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Compiler Version",
          "type": "string"
        },
        "case_ref": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Case Ref",
          "type": "string"
        },
        "chart_version_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Chart Version Id",
          "type": "string"
        },
        "world_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "World Id",
          "type": "string"
        },
        "life_case_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Life Case Id",
          "type": "string"
        },
        "life_case_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Life Case Version",
          "type": "string"
        },
        "source_updated_at": {
          "format": "date-time",
          "title": "Source Updated At",
          "type": "string"
        },
        "source_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "compiler_version",
        "case_ref",
        "chart_version_id",
        "world_id",
        "life_case_id",
        "life_case_version",
        "source_updated_at",
        "source_hash"
      ],
      "title": "CanonicalSceneIdentity",
      "type": "object"
    },
    "CaseWorkspaceState": {
      "additionalProperties": false,
      "description": "Shared product selection state; it never owns Mingli cognition.",
      "properties": {
        "schema_version": {
          "const": "deepbazi.case_workspace_state.v2",
          "default": "deepbazi.case_workspace_state.v2",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "chart_version_id": {
          "default": "",
          "title": "Chart Version Id",
          "type": "string"
        },
        "life_case_version": {
          "default": "",
          "title": "Life Case Version",
          "type": "string"
        },
        "scene_id": {
          "default": "",
          "title": "Scene Id",
          "type": "string"
        },
        "scene_source_hash": {
          "default": "",
          "title": "Scene Source Hash",
          "type": "string"
        },
        "selected_period": {
          "title": "Selected Period",
          "type": "string"
        },
        "system_period": {
          "title": "System Period",
          "type": "string"
        },
        "active_domain": {
          "default": "whole_chart",
          "title": "Active Domain",
          "type": "string"
        },
        "active_mode": {
          "default": "member",
          "enum": [
            "guest",
            "member",
            "practitioner",
            "research"
          ],
          "title": "Active Mode",
          "type": "string"
        },
        "current_surface": {
          "default": "overview",
          "enum": [
            "overview",
            "onecanvas",
            "xiangfa",
            "theater",
            "mingli_lab"
          ],
          "title": "Current Surface",
          "type": "string"
        },
        "selected_semantic_refs": {
          "items": {
            "type": "string"
          },
          "title": "Selected Semantic Refs",
          "type": "array"
        },
        "focused_path_ref": {
          "default": "",
          "title": "Focused Path Ref",
          "type": "string"
        },
        "temporal_stage": {
          "default": "natal",
          "enum": [
            "natal",
            "luck",
            "annual"
          ],
          "title": "Temporal Stage",
          "type": "string"
        },
        "theater_timecode_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Theater Timecode Ms",
          "type": "integer"
        },
        "lab_session_id": {
          "default": "",
          "title": "Lab Session Id",
          "type": "string"
        },
        "lab_dirty": {
          "default": false,
          "title": "Lab Dirty",
          "type": "boolean"
        },
        "language": {
          "default": "zh",
          "title": "Language",
          "type": "string"
        },
        "expanded_sections": {
          "items": {
            "type": "string"
          },
          "title": "Expanded Sections",
          "type": "array"
        },
        "conversation_focus": {
          "default": "overview",
          "title": "Conversation Focus",
          "type": "string"
        },
        "draft_input": {
          "default": "",
          "title": "Draft Input",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "case_id",
        "selected_period",
        "system_period",
        "updated_at"
      ],
      "title": "CaseWorkspaceState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One product state bound to one role-filtered canonical scene.",
  "properties": {
    "schema_version": {
      "const": "deepbazi.case_workspace_envelope.v1",
      "default": "deepbazi.case_workspace_envelope.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/CaseWorkspaceState"
    },
    "projection": {
      "$ref": "#/$defs/CanonicalProjectionEnvelope"
    },
    "allowed_surfaces": {
      "items": {
        "enum": [
          "overview",
          "onecanvas",
          "xiangfa",
          "theater",
          "mingli_lab"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Surfaces",
      "type": "array"
    },
    "creates_mingli_facts": {
      "const": false,
      "default": false,
      "title": "Creates Mingli Facts",
      "type": "boolean"
    },
    "creates_mingli_claims": {
      "const": false,
      "default": false,
      "title": "Creates Mingli Claims",
      "type": "boolean"
    },
    "writes_chart": {
      "const": false,
      "default": false,
      "title": "Writes Chart",
      "type": "boolean"
    },
    "writes_life_case": {
      "const": false,
      "default": false,
      "title": "Writes Life Case",
      "type": "boolean"
    }
  },
  "required": [
    "state",
    "projection",
    "allowed_surfaces"
  ],
  "title": "CaseWorkspaceEnvelope",
  "type": "object"
}
