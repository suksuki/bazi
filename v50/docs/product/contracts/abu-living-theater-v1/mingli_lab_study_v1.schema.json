{
  "$defs": {
    "AssertionLifecycle": {
      "enum": [
        "candidate",
        "committed",
        "superseded",
        "rejected",
        "legacy_unresolved"
      ],
      "title": "AssertionLifecycle",
      "type": "string"
    },
    "CanonicalSceneIdentity": {
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "compiler_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Compiler Version",
          "type": "string"
        },
        "case_ref": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Case Ref",
          "type": "string"
        },
        "chart_version_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Chart Version Id",
          "type": "string"
        },
        "world_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "World Id",
          "type": "string"
        },
        "life_case_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Life Case Id",
          "type": "string"
        },
        "life_case_version": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Life Case Version",
          "type": "string"
        },
        "source_updated_at": {
          "format": "date-time",
          "title": "Source Updated At",
          "type": "string"
        },
        "source_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "scene_id",
        "compiler_version",
        "case_ref",
        "chart_version_id",
        "world_id",
        "life_case_id",
        "life_case_version",
        "source_updated_at",
        "source_hash"
      ],
      "title": "CanonicalSceneIdentity",
      "type": "object"
    },
    "LabCandidateRevision": {
      "additionalProperties": false,
      "description": "An isolated candidate revision; it is never a formal LifeCase assertion.",
      "properties": {
        "schema_version": {
          "const": "deepbazi.lab_candidate_revision.v1",
          "default": "deepbazi.lab_candidate_revision.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "revision_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Revision Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "relation_assertions": {
          "items": {
            "$ref": "#/$defs/RelationAssertion"
          },
          "title": "Relation Assertions",
          "type": "array"
        },
        "path_assertions": {
          "items": {
            "$ref": "#/$defs/PathAssertion"
          },
          "title": "Path Assertions",
          "type": "array"
        },
        "interpretation": {
          "default": "",
          "maxLength": 2000,
          "title": "Interpretation",
          "type": "string"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "counter_signals": {
          "items": {
            "type": "string"
          },
          "title": "Counter Signals",
          "type": "array"
        },
        "supersedes_revision_id": {
          "default": "",
          "maxLength": 180,
          "title": "Supersedes Revision Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "writes_chart": {
          "const": false,
          "default": false,
          "title": "Writes Chart",
          "type": "boolean"
        },
        "writes_life_case": {
          "const": false,
          "default": false,
          "title": "Writes Life Case",
          "type": "boolean"
        },
        "commits_assertion": {
          "const": false,
          "default": false,
          "title": "Commits Assertion",
          "type": "boolean"
        }
      },
      "required": [
        "revision_id",
        "revision",
        "created_at"
      ],
      "title": "LabCandidateRevision",
      "type": "object"
    },
    "LabEvidenceSet": {
      "additionalProperties": false,
      "description": "Evidence required before a Lab candidate may enter a separate risk gate.",
      "properties": {
        "schema_version": {
          "const": "deepbazi.lab_evidence_set.v1",
          "default": "deepbazi.lab_evidence_set.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "positive_fixture_refs": {
          "items": {
            "type": "string"
          },
          "title": "Positive Fixture Refs",
          "type": "array"
        },
        "negative_fixture_refs": {
          "items": {
            "type": "string"
          },
          "title": "Negative Fixture Refs",
          "type": "array"
        },
        "boundary_fixture_refs": {
          "items": {
            "type": "string"
          },
          "title": "Boundary Fixture Refs",
          "type": "array"
        },
        "synthetic_case_refs": {
          "items": {
            "type": "string"
          },
          "title": "Synthetic Case Refs",
          "type": "array"
        },
        "counterexample_refs": {
          "items": {
            "type": "string"
          },
          "title": "Counterexample Refs",
          "type": "array"
        },
        "resolved_counterexample_refs": {
          "items": {
            "type": "string"
          },
          "title": "Resolved Counterexample Refs",
          "type": "array"
        },
        "regression_refs": {
          "items": {
            "type": "string"
          },
          "title": "Regression Refs",
          "type": "array"
        }
      },
      "title": "LabEvidenceSet",
      "type": "object"
    },
    "LabPathComparison": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "deepbazi.lab_path_comparison.v1",
          "default": "deepbazi.lab_path_comparison.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "comparison_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Comparison Id",
          "type": "string"
        },
        "path_assertion_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Path Assertion Refs",
          "type": "array"
        },
        "selected_path_assertion_ref": {
          "default": "",
          "maxLength": 180,
          "title": "Selected Path Assertion Ref",
          "type": "string"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "needs_evidence",
            "resolved",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_refs": {
          "items": {
            "type": "string"
          },
          "title": "Reason Refs",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "comparison_id",
        "path_assertion_refs",
        "created_at"
      ],
      "title": "LabPathComparison",
      "type": "object"
    },
    "MingliLabSession": {
      "additionalProperties": false,
      "description": "Shared non-authoritative identity for every Mingli Lab experiment.",
      "properties": {
        "schema_version": {
          "const": "deepbazi.mingli_lab_session.v1",
          "default": "deepbazi.mingli_lab_session.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "participant_run_id": {
          "default": "",
          "maxLength": 180,
          "title": "Participant Run Id",
          "type": "string"
        },
        "case_ref": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Case Ref",
          "type": "string"
        },
        "scene_id": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Scene Id",
          "type": "string"
        },
        "scene_source_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Scene Source Hash",
          "type": "string"
        },
        "disclosure_hash": {
          "maxLength": 64,
          "minLength": 64,
          "title": "Disclosure Hash",
          "type": "string"
        },
        "experiment_kind": {
          "enum": [
            "mechanism_ablation",
            "temporal_hypothesis",
            "relation_inspection",
            "candidate_interpretation",
            "competing_path_comparison",
            "synthetic_case",
            "counterexample_review",
            "algorithm_change_validation"
          ],
          "title": "Experiment Kind",
          "type": "string"
        },
        "base_snapshot_ref": {
          "maxLength": 220,
          "minLength": 1,
          "title": "Base Snapshot Ref",
          "type": "string"
        },
        "source_mode": {
          "enum": [
            "canonical_projection",
            "synthetic_fixture",
            "legacy_unresolved"
          ],
          "title": "Source Mode",
          "type": "string"
        },
        "synthetic_fixture_ref": {
          "default": "",
          "maxLength": 220,
          "title": "Synthetic Fixture Ref",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "modified",
            "restored",
            "saved",
            "discarded"
          ],
          "title": "Status",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "writes_chart": {
          "const": false,
          "default": false,
          "title": "Writes Chart",
          "type": "boolean"
        },
        "writes_life_case": {
          "const": false,
          "default": false,
          "title": "Writes Life Case",
          "type": "boolean"
        },
        "promotes_candidate": {
          "const": false,
          "default": false,
          "title": "Promotes Candidate",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "case_ref",
        "scene_id",
        "scene_source_hash",
        "disclosure_hash",
        "experiment_kind",
        "base_snapshot_ref",
        "source_mode",
        "created_at",
        "updated_at"
      ],
      "title": "MingliLabSession",
      "type": "object"
    },
    "MingliRelationState": {
      "enum": [
        "potential",
        "structural",
        "time_activated",
        "effective"
      ],
      "title": "MingliRelationState",
      "type": "string"
    },
    "NodeRef": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": "deepbazi.node_ref.v1",
          "title": "Version",
          "type": "string"
        },
        "node_ref": {
          "default": "",
          "title": "Node Ref",
          "type": "string"
        },
        "scene_ref": {
          "title": "Scene Ref",
          "type": "string"
        },
        "life_case_id": {
          "title": "Life Case Id",
          "type": "string"
        },
        "chart_version_id": {
          "title": "Chart Version Id",
          "type": "string"
        },
        "world_id": {
          "title": "World Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "natal",
            "luck",
            "year",
            "month",
            "other"
          ],
          "title": "Scope",
          "type": "string"
        },
        "slot": {
          "title": "Slot",
          "type": "string"
        },
        "level": {
          "enum": [
            "pillar",
            "stem",
            "branch",
            "hidden_stem",
            "other"
          ],
          "title": "Level",
          "type": "string"
        },
        "component": {
          "title": "Component",
          "type": "string"
        },
        "temporal_snapshot_ref": {
          "default": "",
          "title": "Temporal Snapshot Ref",
          "type": "string"
        }
      },
      "required": [
        "scene_ref",
        "life_case_id",
        "chart_version_id",
        "world_id",
        "scope",
        "slot",
        "level",
        "component"
      ],
      "title": "NodeRef",
      "type": "object"
    },
    "PathAssertion": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": "deepbazi.path_assertion.v1",
          "title": "Version",
          "type": "string"
        },
        "assertion_id": {
          "default": "",
          "title": "Assertion Id",
          "type": "string"
        },
        "path_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathKey"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "assertion_version": {
          "title": "Assertion Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AssertionLifecycle"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceRecord"
        },
        "source_candidate_ref": {
          "default": "",
          "title": "Source Candidate Ref",
          "type": "string"
        },
        "segment_validation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Segment Validation Refs",
          "type": "array"
        },
        "rejected_segment_refs": {
          "items": {
            "type": "string"
          },
          "title": "Rejected Segment Refs",
          "type": "array"
        },
        "supersedes": {
          "default": "",
          "title": "Supersedes",
          "type": "string"
        },
        "statement": {
          "default": "",
          "title": "Statement",
          "type": "string"
        },
        "legacy_ref": {
          "default": "",
          "title": "Legacy Ref",
          "type": "string"
        },
        "unresolved_reason": {
          "default": "",
          "title": "Unresolved Reason",
          "type": "string"
        }
      },
      "required": [
        "assertion_version",
        "status",
        "provenance"
      ],
      "title": "PathAssertion",
      "type": "object"
    },
    "PathKey": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": "deepbazi.path_key.v1",
          "title": "Version",
          "type": "string"
        },
        "path_key": {
          "default": "",
          "title": "Path Key",
          "type": "string"
        },
        "scene_ref": {
          "title": "Scene Ref",
          "type": "string"
        },
        "ontology_version": {
          "default": "deepbazi.relation-ontology.pre-ra1.v1",
          "title": "Ontology Version",
          "type": "string"
        },
        "node_refs": {
          "items": {
            "$ref": "#/$defs/NodeRef"
          },
          "minItems": 2,
          "title": "Node Refs",
          "type": "array"
        },
        "relation_keys": {
          "items": {
            "$ref": "#/$defs/RelationKey"
          },
          "minItems": 1,
          "title": "Relation Keys",
          "type": "array"
        },
        "scope": {
          "default": "natal",
          "enum": [
            "natal",
            "luck",
            "year",
            "month",
            "other"
          ],
          "title": "Scope",
          "type": "string"
        },
        "directed": {
          "const": true,
          "default": true,
          "title": "Directed",
          "type": "boolean"
        }
      },
      "required": [
        "scene_ref",
        "node_refs",
        "relation_keys"
      ],
      "title": "PathKey",
      "type": "object"
    },
    "ProvenanceRecord": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": "deepbazi.relation_path_provenance.v1",
          "title": "Version",
          "type": "string"
        },
        "provenance_id": {
          "default": "",
          "title": "Provenance Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "graph_candidate",
            "reasoner_commit",
            "legacy_exact_import",
            "legacy_unresolved"
          ],
          "title": "Source",
          "type": "string"
        },
        "producer_id": {
          "title": "Producer Id",
          "type": "string"
        },
        "producer_version": {
          "title": "Producer Version",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "source",
        "producer_id",
        "producer_version",
        "created_at"
      ],
      "title": "ProvenanceRecord",
      "type": "object"
    },
    "RelationAssertion": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": "deepbazi.relation_assertion.v1",
          "title": "Version",
          "type": "string"
        },
        "assertion_id": {
          "default": "",
          "title": "Assertion Id",
          "type": "string"
        },
        "relation_key": {
          "$ref": "#/$defs/RelationKey"
        },
        "assertion_version": {
          "title": "Assertion Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AssertionLifecycle"
        },
        "provenance": {
          "$ref": "#/$defs/ProvenanceRecord"
        },
        "relation_state": {
          "$ref": "#/$defs/MingliRelationState",
          "default": "effective"
        },
        "mechanism_ref": {
          "default": "legacy_exact_relation",
          "title": "Mechanism Ref",
          "type": "string"
        },
        "position_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationPositionContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification_refs": {
          "items": {
            "type": "string"
          },
          "title": "Verification Refs",
          "type": "array"
        },
        "supersedes": {
          "default": "",
          "title": "Supersedes",
          "type": "string"
        },
        "statement": {
          "default": "",
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "relation_key",
        "assertion_version",
        "status",
        "provenance"
      ],
      "title": "RelationAssertion",
      "type": "object"
    },
    "RelationDirectionality": {
      "enum": [
        "directed",
        "symmetric"
      ],
      "title": "RelationDirectionality",
      "type": "string"
    },
    "RelationKey": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": "deepbazi.relation_key.v1",
          "title": "Version",
          "type": "string"
        },
        "relation_key": {
          "default": "",
          "title": "Relation Key",
          "type": "string"
        },
        "scene_ref": {
          "title": "Scene Ref",
          "type": "string"
        },
        "ontology_version": {
          "default": "deepbazi.relation-ontology.pre-ra1.v1",
          "title": "Ontology Version",
          "type": "string"
        },
        "relation_type": {
          "title": "Relation Type",
          "type": "string"
        },
        "participant_refs": {
          "items": {
            "$ref": "#/$defs/NodeRef"
          },
          "minItems": 2,
          "title": "Participant Refs",
          "type": "array"
        },
        "directionality": {
          "$ref": "#/$defs/RelationDirectionality"
        },
        "arity": {
          "default": 0,
          "minimum": 2,
          "title": "Arity",
          "type": "integer"
        },
        "scope": {
          "default": "natal",
          "enum": [
            "natal",
            "luck",
            "year",
            "month",
            "other"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scene_ref",
        "relation_type",
        "participant_refs",
        "directionality"
      ],
      "title": "RelationKey",
      "type": "object"
    },
    "RelationPositionContext": {
      "additionalProperties": false,
      "description": "Typed location evidence; it never decides strength or effectiveness.",
      "properties": {
        "version": {
          "default": "deepbazi.relation_position_context.six02.v1",
          "title": "Version",
          "type": "string"
        },
        "source_scope": {
          "enum": [
            "natal",
            "luck",
            "year",
            "month",
            "other"
          ],
          "title": "Source Scope",
          "type": "string"
        },
        "target_scope": {
          "enum": [
            "natal",
            "luck",
            "year",
            "month",
            "other"
          ],
          "title": "Target Scope",
          "type": "string"
        },
        "source_slot": {
          "title": "Source Slot",
          "type": "string"
        },
        "target_slot": {
          "title": "Target Slot",
          "type": "string"
        },
        "source_level": {
          "enum": [
            "pillar",
            "stem",
            "branch",
            "hidden_stem",
            "other"
          ],
          "title": "Source Level",
          "type": "string"
        },
        "target_level": {
          "enum": [
            "pillar",
            "stem",
            "branch",
            "hidden_stem",
            "other"
          ],
          "title": "Target Level",
          "type": "string"
        },
        "adjacent": {
          "default": false,
          "title": "Adjacent",
          "type": "boolean"
        },
        "column_span": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Span"
        },
        "intervening_node_refs": {
          "items": {
            "type": "string"
          },
          "title": "Intervening Node Refs",
          "type": "array"
        },
        "ref_namespace": {
          "default": "node_ref",
          "enum": [
            "candidate_node_key",
            "node_ref"
          ],
          "title": "Ref Namespace",
          "type": "string"
        },
        "direction": {
          "default": "other",
          "enum": [
            "same_column",
            "left_to_right",
            "right_to_left",
            "symmetric",
            "temporal_to_natal",
            "natal_to_temporal",
            "cross_temporal",
            "other"
          ],
          "title": "Direction",
          "type": "string"
        },
        "scene_layer": {
          "default": "natal_state",
          "enum": [
            "natal_state",
            "luck_state",
