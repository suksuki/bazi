{
  "schema_version": "deepbazi.topic_package.v1",
  "topic": {
    "topic_id": "topic-01-irreplaceable-node",
    "version": "1.0.0",
    "title": "阿布说命 01｜谁是命局里不可替代的节点？",
    "purpose": "让参与者在受控沙盒中亲手拿开一个节点，比较已批准路径的结构变化。",
    "audience": ["member", "practitioner", "research_master"],
    "supported_modes": ["solo", "time_shift", "replay"],
    "required_experience_capabilities": [
      "approved_reasoning_path",
      "mingli_mechanism_snapshot",
      "single_node_ablation",
      "topic_exploration"
    ],
    "knowledge_refs": ["approved-cognitive-record", "deterministic-graph", "structural-ablation"]
  },
  "entry_node": "experiment_entry",
  "fallback_entry_nodes": {
    "personal_ready": "experiment_entry",
    "chart_facts_only": "experiment_entry",
    "observer": "experiment_entry"
  },
  "scene_nodes": [
    {
      "node_id": "experiment_entry",
      "act": "structural-ablation-intro",
      "dramatic_purpose": "先说明实验边界，再由参与者主动进入私人命盘沙盒。",
      "visibility": "public",
      "expected_duration_seconds": 18,
      "cue_template_ids": [],
      "interaction": {
        "kind": "ready_barrier",
        "prompt": "准备好后，进入你的命局结构实验。",
        "required": false
      },
      "data_bindings": [],
      "transitions": [
        {"event": "next", "target": "experiment_private"}
      ],
      "timeout_behavior": "wait"
    },
    {
      "node_id": "experiment_private",
      "act": "single-node-structural-ablation",
      "dramatic_purpose": "猜测关键节点、执行单节点消融、比较路径变化并恢复原局。",
      "visibility": "participant_private",
      "expected_duration_seconds": 240,
      "cue_template_ids": ["experiment-private-opening"],
      "interaction": {
        "kind": "mingli_experiment",
        "prompt": "先猜一个你认为不可替代的节点，再亲手把它暂时拿开。",
        "required": false
      },
      "data_bindings": [
        "envelope.allowed_chart_facts",
        "envelope.approved_claims",
        "envelope.approved_reasoning_steps",
        "envelope.competing_hypotheses"
