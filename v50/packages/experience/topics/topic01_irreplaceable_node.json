      "transitions": [
        {"event": "complete", "target": "experiment_close"}
      ],
      "timeout_behavior": "fallback",
      "fallback_node": "experiment_close",
      "rejoin_node": "experiment_close"
    },
    {
      "node_id": "experiment_close",
      "act": "structural-ablation-close",
      "dramatic_purpose": "确认原局已恢复，并把观察保存在当前专题探索中。",
      "visibility": "public",
      "expected_duration_seconds": 12,
      "cue_template_ids": [],
      "interaction": {"kind": "none"},
      "data_bindings": [],
      "transitions": [],
      "timeout_behavior": "wait"
    }
  ],
  "cue_templates": [
    {
      "template_id": "experiment-private-opening",
      "visibility": "participant_private",
      "semantic_intent": "introduce_structural_ablation_without_new_judgment",
      "required_claim_category": "baseline",
      "dialogue_template": "一张命盘里，出现次数最多的字，不一定最关键。真正值得看的，是把一个节点暂时拿开以后，原来的路径还剩下多少。今天我们只做结构实验，不改你的原命盘，也不替现实含义补答案。",
      "subtitle_template": "实验分支：只比较结构变化，不修改原命盘。",
      "phrase_policy": "deterministic_structure_only",
      "voice": {
        "profile": "abu-main",
        "mode": "performer",
        "emotion": "curious-professional",
        "speed": 0.96
      },
      "actor": {
        "expression": "curious",
        "motion_asset": "abu-head-tilt",
        "loop": true
      },
      "stage": [
        {"command": "set_background", "asset_ref": "valley-dawn"},
        {"command": "show_chart_facts", "source": "envelope.allowed_chart_facts"}
      ],
      "subtitle": {"style": "mingli-experiment"}
    }
  ],
  "director_script": {
    "temporary_dialogue": {},
    "timing_notes": {
      "experiment-private-opening": "The deterministic experiment UI owns all structural changes after the opening cue."
    }
  },
