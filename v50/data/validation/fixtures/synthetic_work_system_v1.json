{
  "group": "synthetic_work_system_v1",
  "description": "Synthetic Chart Lab v1. These cases validate path/role/importance/ablation behavior, not final fortune-telling.",
  "cases": [
    {
      "case_id": "bridge_node_si_you_chou_complete",
      "structural_variable": "complete si-you-chou bridge should identify 酉 as bridge and 丁 as converter",
      "birth_input": {
        "birth_input_id": "birth.synthetic.work.001",
        "name": "bridge_node_type",
        "gender": "male",
        "calendar_type": "solar",
        "birth_date": "1980-05-01",
        "birth_time": "酉时",
        "birth_location": "Shanghai",
        "timezone": "Asia/Shanghai",
        "year_pillar": "丁巳",
        "month_pillar": "乙巳",
        "day_pillar": "乙丑",
        "hour_pillar": "乙酉",
        "input_quality": "explicit_pillars"
      },
      "expected_roles": {
        "酉:hour_branch": ["bridge_node", "single_failure_node"],
        "丁:year_stem": ["converter_node"],
        "巳:month_branch": ["environment_node", "activation_node"]
      },
      "expected_path_hints": ["mechanism_hint.combination_bridge"],
      "expected_critical_nodes": ["酉:hour_branch", "丁:year_stem"],
      "expected_ablation_prefix": ["酉:hour_branch", "丁:year_stem"],
      "must_not_roles": {
        "巳:month_branch": ["unconditional_master_controller"]
      }
    },
