# —— 本机直连 FastAPI（默认）——
NEXT_PUBLIC_QIAZHI_API=http://127.0.0.1:8001
# NEXT_PUBLIC_QIAZHI_SAME_ORIGIN_PROXY 不设或 0

# —— 公网：生产构建若未配公网 API URL，next.config 会默认把 /api 反代到 QIAZHI_INTERNAL_API_URL（8001）。
# 若 Nginx 已把 /api 指到 uvicorn，Next 内勿再重复反代：设 NEXT_PUBLIC_QIAZHI_DISABLE_SAME_ORIGIN_REWRITE=1
# 仍误打 127.0.0.1 时，运行时代码会强制改为同源 /api（可设 NEXT_PUBLIC_QIAZHI_DISABLE_LOOPBACK_GUARD=1 关闭）。
# 示例见 deploy/nginx-qiazhi-dblife.example.conf

# 须与后端 QIAZHI_ADMIN_TOKEN 一致
NEXT_PUBLIC_QIAZHI_ADMIN_TOKEN=local-dev-qiazhi-admin

# 终判 NDJSON 流式（/api/v1/final-verdict/stream）；需 OpenAI 兼容 LLM。不设或 0 则走普通 JSON POST。
# NEXT_PUBLIC_QIAZHI_FINAL_VERDICT_NDJSON=1
